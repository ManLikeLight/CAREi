modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "carei-browser-storage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "carei-production-build"

[[workflows.workflow]]
name = "carei-browser-storage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/carei-app typecheck:browser && pnpm --filter @workspace/carei-app test:browser"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "carei-production-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5179 BASE_PATH=/ pnpm --filter @workspace/carei-app build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
